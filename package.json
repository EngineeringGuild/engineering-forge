{
  "name": "engineering-forge",
  "version": "0.1.0",
  "private": true,
  "description": "A physics puzzle game that teaches real engineering — build it, test it, let the physics decide.",
  "type": "module",
  "workspaces": [
    "game"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@engineering-forge/game",
    "build": "npm run build --workspace=@engineering-forge/game",
    "test": "npm run test --workspace=@engineering-forge/game",
    "lint": "npm run lint --workspace=@engineering-forge/game",
    "type-check": "npm run type-check --workspace=@engineering-forge/game",
    "setup": "npm install"
  },
  "keywords": [
    "education",
    "gaming",
    "engineering",
    "physics",
    "puzzle"
  ],
  "author": "Engineering Guild",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EngineeringGuild/engineering-forge.git"
  },
  "bugs": {
    "url": "https://github.com/EngineeringGuild/engineering-forge/issues"
  },
  "dependencies": {
    "matter-js": "^0.20.0"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2"
  }
}
