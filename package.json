    "type-check": "cd game && npm run type-check",
    "setup": "cd game && npm install"
  },
  "keywords": [
    "education",
    "gaming",
    "engineering",
    "physics",
    "puzzle"
  ],
  "author": "Engineering Guild",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EngineeringGuild/engineering-forge.git"
  },
  "bugs": {
    "url": "https://github.com/EngineeringGuild/engineering-forge/issues"
  }
}
